rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kandungan laman web: semua orang boleh baca, hanya admin (log masuk) boleh ubah.
    match /settings/{doc}   { allow read: if true; allow write: if request.auth != null; }
    match /menu/{doc}       { allow read: if true; allow write: if request.auth != null; }
    match /promotions/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /gallery/{doc}    { allow read: if true; allow write: if request.auth != null; }
    match /reviews/{doc}    { allow read: if true; allow write: if request.auth != null; }

    // Tempahan meja: pelanggan boleh hantar (create) sahaja; admin boleh urus.
    match /reservations/{doc} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['nama','telefon','tarikh','masa','pax','nota','status','createdAt'])
                    && request.resource.data.nama is string && request.resource.data.nama.size() <= 100
                    && request.resource.data.telefon is string && request.resource.data.telefon.size() <= 30
                    && (!('nota' in request.resource.data)
                        || (request.resource.data.nota is string && request.resource.data.nota.size() <= 500));
      allow read, update, delete: if request.auth != null;
    }
  }
}
